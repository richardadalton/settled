{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "title": "Settled — Audit Log",
  "uid": "settled-audit-log",
  "description": "Operational dashboard for the Settled tamper-evident audit log server.",
  "tags": ["settled", "audit-log"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tree Size",
      "description": "Number of entries covered by the latest Signed Tree Head.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "targets": [
        {
          "expr": "settled_tree_size",
          "legendFormat": "tree size",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Entries",
      "description": "Cumulative entries appended to the log (durably stored, may not yet be in the STH).",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "targets": [
        {
          "expr": "settled_entries_appended_total",
          "legendFormat": "entries",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "STH Age",
      "description": "Seconds since the latest Signed Tree Head was produced. Alert if this exceeds sth_interval_secs significantly.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 120 },
            { "color": "red", "value": 300 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 } },
      "targets": [
        {
          "expr": "(time() * 1e9 - settled_sth_last_timestamp_ns) / 1e9",
          "legendFormat": "age",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Append p50",
      "description": "Median append latency over the last 5 minutes.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "µs", "decimals": 0 } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(settled_append_duration_seconds_bucket[5m])) * 1e6",
          "legendFormat": "p50",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Append p99",
      "description": "99th-percentile append latency over the last 5 minutes.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 5000 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "µs", "decimals": 0 } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(settled_append_duration_seconds_bucket[5m])) * 1e6",
          "legendFormat": "p99",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error Rate",
      "description": "gRPC errors per second across all RPCs over the last 5 minutes.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "red", "value": 1 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(rate(settled_rpc_errors_total[5m]))",
          "legendFormat": "errors/s",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Append Throughput",
      "description": "Entries appended per second (rate over 1 minute). Includes both Append and BatchAppend.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "rate(settled_entries_appended_total[1m])",
          "legendFormat": "entries/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Append Latency Percentiles",
      "description": "p50, p95, and p99 append latency. Target: p50 < 100µs, p99 < 1ms.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "µs", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(settled_append_duration_seconds_bucket[5m])) * 1e6",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(settled_append_duration_seconds_bucket[5m])) * 1e6",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(settled_append_duration_seconds_bucket[5m])) * 1e6",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RPC Errors by Method and Code",
      "description": "gRPC errors per second broken down by RPC name and status code. INTERNAL errors indicate bugs; NOT_FOUND and INVALID_ARGUMENT may indicate client issues.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "rate(settled_rpc_errors_total[5m])",
          "legendFormat": "{{rpc}} / {{code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "STH Signing Activity",
      "description": "Rate of Signed Tree Heads produced per minute and STH signing duration.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "signings/min" }, "properties": [{ "id": "unit", "value": "short" }] },
          { "matcher": { "id": "byName", "options": "sign duration p99" }, "properties": [{ "id": "unit", "value": "ms" }] }
        ]
      },
      "targets": [
        {
          "expr": "rate(settled_sth_signed_total[1m]) * 60",
          "legendFormat": "signings/min"
        },
        {
          "expr": "histogram_quantile(0.99, rate(settled_sth_sign_duration_seconds_bucket[5m])) * 1e3",
          "legendFormat": "sign duration p99"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "hide": 0,
        "label": "Prometheus"
      }
    ]
  }
}
