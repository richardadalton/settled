{
  "name": "@daltonr/settled-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Settled tamper-evident audit log",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "proto"],
  "scripts": {
    "sync-proto": "mkdir -p proto && cp ../../proto/settled.v1.proto proto/settled.v1.proto",
    "prebuild": "npm run sync-proto",
    "pretest": "npm run sync-proto",
    "prepack": "npm run sync-proto && npm run build",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
